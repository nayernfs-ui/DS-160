# Brevo (SendinBlue) / Email configuration example
# Copy to .env and fill values. Do NOT check .env into source control.

# Brevo API Key (transactional email)
SENDINBLUE_API_KEY=your_brevo_api_key_here

# The sender address that appears in the "From" field (must be verified in Brevo)
SENDER_EMAIL="My App <no-reply@example.com>"

# Where submissions will be delivered (default is the project's owner email)
RECIPIENT_EMAIL=recipient@example.com

# Optional: override recipient for local testing
# TEST_RECIPIENT_EMAIL=your_email@example.com

# One-time test endpoint token (set to enable /api/test-email)
# Keep this secret and do not share or commit it
# TEST_EMAIL_TOKEN=some_long_random_string
