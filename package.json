{
  "name": "ds-160",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "vercel dev",
    "smoke-docx": "node tools/smoke-test-docx.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "lint:ci": "eslint . --ext .js --max-warnings=0",
    "lint:html": "html-validate index.html",
    "format": "prettier --write .",
    "prettier:check": "prettier --check .",
    "depcheck": "depcheck --specials=bin --json",

    "test:visits": "node tests/unit/visits.test.js",
    "test:military": "node tests/unit/military.test.js",
    "test:education": "node tests/unit/education.test.js",
    "test:country-mapping": "node tests/unit/country-mapping.test.js",
    "test:work-info": "node tests/unit/work-info.test.js",
    "test:family": "node tests/unit/family.test.js",
    "test:api-health": "node tests/unit/api-health.test.js",

    "test:stub-email": "node tools/test-email-stub.js",
    "test:docx-arabic": "node test/docx-arabic.test.js",
    "test:ci": "npm run lint:ci && npm run lint:html && npm run smoke-docx && npm run test:stub-email && npm run test:docx-arabic",
    "test": "npm run test:ci",

    "promote:vercel": "node tools/vercel-promote.js",
    "test:vercel-promote": "node tests/unit/vercel-promote.test.js",
    "prepare": "husky install",
    "check-env": "node tools/check-env.js",
    "live-smoke": "node tests/e2e/puppeteer-visits-live.js",
    "test:e2e:options-row": "node tests/e2e/puppeteer-options-row-visual.js",
    "test:e2e:options-row-compare": "node tests/e2e/compare-options-row.js",
    "test:e2e:options-row-accept": "node tests/e2e/update-options-row-baseline.js",
    "test:e2e:other-passport-options-row": "node tests/e2e/check-other-passport-options-row.js",
    "check:main": "npm run lint:ci && npm test"
  },
  "dependencies": {
    "arabic-reshaper": "^1.1.0",
    "docx": "^9.5.1",
    "sib-api-v3-sdk": "^8.5.0"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ],
    "index.html": [
      "prettier --write",
      "npm run lint:html"
    ]
  },
  "devDependencies": {
    "depcheck": "^1.4.7",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "html-validate": "^9.7.1",
    "husky": "^8.0.3",
    "jsdom": "^22.1.0",
    "jszip": "^3.10.1",
    "lint-staged": "^16.2.7",
    "pixelmatch": "^5.3.0",
    "pngjs": "^6.0.0",
    "prettier": "^2.8.8",
    "puppeteer": "^24.33.0",
    "nock": "^13.3.0",
    "xmldom": "^0.6.0"
  }
}
